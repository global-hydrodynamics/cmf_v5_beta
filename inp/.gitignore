# Additional datasets supplied by the distribution package.
# These files are managed separately from the Git repository.
/ELSE_GPCC/


# ERA5-Land datasets contain downloaded/converted NetCDF, reports and run logs.
# Keep them outside the tool directory and out of source-control commits.
/ERA5land-*/
# The same ERA5-Land output layout is ignored when users choose a custom dataset name.
/*/original/
/*/logs/
/*/runoff_*.nc
/*/runoff_info_CaMaFlood.txt
# Python bytecode from the download tools is a local generated artifact.
/download_ERA5-Land/**/__pycache__/
/download_ERA5-Land/**/*.pyc

# Planned GitHub hourly Japan fixture: track its explanation and converted daily NetCDF.
# Actual data must pass size, source-license and validation review before git add/push.
!/repo-ERA5land-jpn_hourly/
/repo-ERA5land-jpn_hourly/*
!/repo-ERA5land-jpn_hourly/README.md
!/repo-ERA5land-jpn_hourly/runoff_????????.nc
# Raw CDS downloads, run logs and generated information remain reproducible local artifacts.
/repo-ERA5land-jpn_hourly/original/
/repo-ERA5land-jpn_hourly/logs/
/repo-ERA5land-jpn_hourly/runoff_info_CaMaFlood.txt

# Repository global sample: keep converted monthly forcing and its explanation.
# Raw CDS inputs, logs and generated reports are reproducible local artifacts.
!/repo-ERA5land-glb_2day/
/repo-ERA5land-glb_2day/*
!/repo-ERA5land-glb_2day/README.md
!/repo-ERA5land-glb_2day/runoff_??????.nc
/repo-ERA5land-glb_2day/original/
/repo-ERA5land-glb_2day/logs/
/repo-ERA5land-glb_2day/runoff_info_CaMaFlood.txt
