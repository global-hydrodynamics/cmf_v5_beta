!/map/Rhine_15min/script_rhine/README.md
/map/Rhine_15min/script_params/*
!/map/Rhine_15min/script_params/*.sh
!/map/Rhine_15min/script_params/README.md
/map/Rhine_15min/script_format_conv/*
!/map/Rhine_15min/script_format_conv/*.sh
!/map/Rhine_15min/script_format_conv/*.txt
!/map/Rhine_15min/script_format_conv/README.md

