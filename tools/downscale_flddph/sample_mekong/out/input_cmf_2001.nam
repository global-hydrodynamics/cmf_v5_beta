&NRUNVER
LADPSTP = .TRUE.       ! TRUE enables adaptive time stepping.
LPTHOUT = .TRUE.       ! TRUE enables bifurcation routing.
LDAMOUT = .FALSE.       ! TRUE enables reservoir operation; FALSE disables it.
LRESTART = .TRUE.     ! TRUE reads initial state from CRESTSTO; FALSE starts without a restart.
/
&NDIMTIME
CDIMINFO = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/diminfo_repo-mek_1deg.txt"    ! Map and runoff-grid dimensions for input mapping.
DT = 3600                 ! Base timestep [s]; adaptive stepping may reduce it.
IFRQ_INP = 24     ! Runoff update interval [hours].
/
&NPARAM
PMANRIV = 0.03D0       ! River Manning roughness coefficient [s m-1/3].
PMANFLD = 0.10D0       ! Floodplain Manning roughness coefficient [s m-1/3].
PDSTMTH = 10000.D0       ! Downstream distance assigned at a river mouth [m].
PCADP = 0.7D0           ! CFL coefficient used by adaptive timestep control [-].
/
&NSIMTIME
SYEAR = 2001            ! First simulation year for this annual run.
SMON = 1                   ! Simulation start month.
SDAY = 1                   ! Simulation start day.
SHOUR = 0                  ! Simulation start hour [0-23].
EYEAR = 2002       ! Exclusive simulation end year (January 1 of the next year).
EMON = 1                   ! Exclusive simulation end month.
EDAY = 1                   ! Exclusive simulation end day.
EHOUR = 0                  ! Exclusive simulation end hour.
/
&NMAP
LMAPCDF = .FALSE.                     ! FALSE uses individual .bin/.nc files; TRUE selects legacy consolidated NetCDF maps.
CNEXTXY = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/nextxy.nc"                ! Downstream river connectivity (nextx/nexty).
CGRAREA = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/ctmare.nc" ! Unit-catchment area [m2].
CELEVTN = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/elevtn.nc" ! Channel-top elevation [m].
CNXTDST = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/nxtdst.nc" ! Distance to downstream unit catchment [m].
CRIVLEN = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/rivlen.nc" ! River-channel length within unit catchment [m].
CFLDHGT = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/fldhgt.nc" ! Floodplain elevation-profile thresholds [m].
CRIVWTH = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/rivwth_merit.nc"                 ! River-channel width [m], selected above.
CRIVHGT = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/rivhgt.nc" ! River-channel depth [m].
CRIVMAN = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/rivman.nc" ! River Manning roughness coefficient.
CPTHOUT = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/netcdf/bifprm.nc" ! Bifurcation channel parameters.
/
&NRESTART
CRESTSTO = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/gosh_test/out/mek02/restart2001010100.nc"  ! Input restart path when LRESTART is true; NONE means no input restart.
CRESTDIR = "./"           ! Directory for restart outputs, relative to the model run directory.
CVNREST = "restart"    ! Prefix for dated restart output files.
LRESTCDF = .TRUE.     ! TRUE writes NetCDF restart; FALSE writes Binary restart.
IFRQ_RST = 0     ! 0=end only; 1-24=hourly; 30=monthly (also writes at end).
/
&NFORCE
LINPCDF = .TRUE.           ! TRUE reads NetCDF runoff; independent of the model-output format.
CROFFREQ = "YEAR"          ! One NetCDF file per calendar year; the reader switches at January 1.
LINTERP = .TRUE.           ! TRUE maps runoff through CINPMAT; FALSE uses nearest-grid mapping.
CINPMAT = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/map/mekong_15min/inpmat_repo-mek_1deg.bin"     ! Binary runoff-to-river input-mapping matrix.
DROFUNIT = 86400000     ! Divide input units by this factor to obtain runoff depth rate [m/s].
CVNTIME = "time"    ! CF time-coordinate variable within each annual file.
CVNROF = "runoff"      ! Runoff data variable within each annual file.
CROFDIR = "/Users/yamadai/Documents/GitHub/cmf_v5_beta/inp/repo-mek_1deg" ! Directory containing annual runoff NetCDF files.
CROFPRE = "runoff"         ! Annual filename prefix: runoffYYYY.nc.
CROFSUF = ".nc"            ! Annual filename suffix.
/
&NOUTPUT
CMF_BASE = "/Users/yamadai/Documents/GitHub/cmf_v5_beta"     ! CaMa-Flood repository/package root.
COUTVAR_TABLE = ""            ! Defaults to CMF_BASE/variable_table/output_variables.csv.
COUTDIR = "./"            ! Output directory relative to the model run directory.
CVARSOUT = "outflw,pthflw,storge,sfcelv,rivdph,flddph,fldfrc,fldare"  ! Comma-separated list of output variables to write.
COUTTAG = "2001"       ! Year tag appended to each output filename.
LOUTVEC = .FALSE.          ! TRUE writes vector output; FALSE writes gridded XY output.
LOUTCDF = .TRUE.       ! TRUE writes NetCDF model output; FALSE writes Binary model output.
IFRQ_OUT = 24     ! Model-output interval [hours], separate from IFRQ_INP.
/
