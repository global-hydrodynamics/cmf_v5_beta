dset ^prmwat.bin
undef -9999
title CaMa-Flood map file prmwat.bin
options yrev little_endian
xdef 1500 linear 123.008333333 0.0166666666667
ydef 1320 linear 24.0083333333 0.0166666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 1
prmwat 1 99 Permanent-water area by unit catchment [m2]
ENDVARS
