dset ^15sec.catmxy.bin
undef -9999
title CaMa-Flood map file 15sec.catmxy.bin
options yrev little_endian
xdef 6000 linear 123.002083333 0.00416666666667
ydef 5280 linear 24.0020833333 0.00416666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 2
catmxx 1 -1,40,2,-1 Regional unit-catchment x index [1]
catmyy 1 -1,40,2,-1 Regional unit-catchment y index [1]
ENDVARS
