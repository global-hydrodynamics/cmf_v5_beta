! CaMa-Flood model grid and runoff input-grid mapping
! DIMINFO describes the model grid; INPUTDIM describes its runoff input.

&DIMINFO
  ! CaMa-Flood model grid
  NX    = 80
  NY    = 120
  NLFP  = 10
  WEST  = 90.0
  EAST  = 110.0
  NORTH = 35.0
  SOUTH = 5.0
/

&INPUTDIM
  ! Runoff input grid and mapping
  INPMAT_FILE = 'inpmat_test-1deg.nc'
  NXIN    = 360
  NYIN    = 180
  INPN    = 4
  WESTIN  = -180.0
  EASTIN  = 180.0
  NORTHIN = 90.0
  SOUTHIN = -90.0
  OLATIN  = 'NtoS'
/
